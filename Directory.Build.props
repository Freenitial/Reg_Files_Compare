<Project>

  <!--
    Common compiler settings shared by every project.
    TargetFramework is intentionally NOT set here so each project can pick its own:
      - RegCompare uses net11.0-windows10.0.17763.0 (DwmSetWindowAttribute, Win32 P/Invokes).
      - RegCompare.Tests matches the same TFM so the ProjectReference resolves cleanly.
  -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <NoWarn>$(NoWarn);AVA2002</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <RootNamespace>RegCompare</RootNamespace>

    <!-- The full Build on publish. The .NET 11 rc.2 SDK publishes Native AOT "optimized" by
         default (UseOptimizedPublish: Compile only, not Build), so Avalonia's XAML compiler never
         rewrites the assembly the AOT compiler reads: the exe starts, then its window dies with
         "No precompiled XAML found for RegCompare.App". Unconditional because PublishAot is set
         later, in RegCompare.csproj; the SDK reads it only when PublishAot is on. build.cmd checks
         the published exe for its compiled XAML (BUILD.md says how). -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
  </PropertyGroup>

</Project>
